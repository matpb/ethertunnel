# EtherTunnel relay configuration (example).
# Copy to /etc/ethertunnel/relay.toml and edit.

[server]
# Base domain. Tunnels live at <label>.<domain>; daemons connect to
# connect.<domain>. The wildcard *.<domain> and connect.<domain> must resolve
# to this server's public IP (DNS-only / grey-cloud; traffic does not transit
# Cloudflare).
domain = "ethertunnel.com"
# Public listen address. One socket serves visitors and daemon control.
listen = "0.0.0.0:443"
# Body returned for a plain GET on the apex.
apex_response = "EtherTunnel relay"

[tls]
# "acme" (production wildcard via Let's Encrypt DNS-01), "self_signed" (dev),
# or "manual" (operator-provided files).
mode = "acme"
# Where issued certs and the ACME account are cached.
state_dir = "/var/lib/ethertunnel/tls"

[tls.acme]
# Contact email for the ACME account / expiry notices.
email = "you@example.com"
# Always issue against staging first on a fresh deployment, then flip to false.
staging = true

[tls.acme.cloudflare]
# Zone id for the base domain.
zone_id = "your-cloudflare-zone-id"
# File holding a Cloudflare API token with Zone:DNS:Edit on the zone.
# Keep it 0600 and owned by the relay user; never inline the token here.
api_token_file = "/etc/ethertunnel/cloudflare.token"

# Operator-provided certificate (only when mode = "manual").
# [tls.manual]
# cert_file = "/etc/ethertunnel/fullchain.pem"
# key_file = "/etc/ethertunnel/key.pem"

[registry]
db_path = "/var/lib/ethertunnel/registry.db"

[tcp]
# Inclusive public-port range daemons may reserve for raw-TCP tunnels.
# IMPORTANT: this entire range must be opened INBOUND on the host firewall AND
# the cloud security group, or --tcp tunnels fail silently (HTTPS tunnels need
# only :443). See the "Firewall / raw-TCP" section in deploy/DEPLOY.md for the
# exact `ufw allow 20000:20999/tcp` and cloud-console steps.
port_range = [20000, 20999]

# Polar.sh licensing. OMIT this whole section for a self-host relay: with no
# [polar] block, clients authenticate by local tokens minted via
# `etun admin token create` and no tunnel cap is enforced — the correct
# default for self-host.
#
# With [polar] present, the relay ALSO accepts Polar license keys as bearer
# credentials: a key is validated against Polar's public customer-portal
# endpoint (no org secret is ever stored on the relay), a relay account is
# provisioned implicitly under the Polar customer id, and the per-plan tunnel
# cap comes from the [polar.benefits] map below. Local admin tokens keep
# working alongside (they are checked first, with no network call).
# [polar]
# # Your Polar organization id (public identifier, but operator-supplied —
# # fill in your own; never commit a real value to a repo).
# organization_id = "YOUR-POLAR-ORG-UUID"
# # Polar API base. Sandbox testing: "https://sandbox-api.polar.sh".
# api_base = "https://api.polar.sh"
# # Re-validate a cached key over HTTP at most this often (seconds). Keeps the
# # relay far inside Polar's customer-portal rate limits.
# cache_ttl_secs = 300
# # Honor a cached "granted" this long past its last successful validation if
# # Polar is unreachable (bounded fail-open window, seconds).
# staleness_secs = 259200
# # How long a key a customer has stopped presenting still counts toward that
# # customer's pooled tunnel cap, for the DESTRUCTIVE downgrade prune only
# # (seconds). Deleting a globally-unique hostname reservation cannot be undone,
# # so it waits far longer than staleness_secs above; live traffic over the cap
# # already stops at staleness_secs. Values below staleness_secs are clamped up
# # to it — a prune stricter than the claim gate would delete what it just
# # authorized.
# cap_prune_grace_secs = 2592000
# # Enforce limit_activations (device binding) via Polar activate()/deactivate().
# activate_on_claim = true
#
# # License-Key BENEFIT id -> max concurrent tunnels. This map is the relay's
# # ONLY source of per-plan capacity (Polar's validate response carries the
# # benefit id, not the product id, and keys hold no custom metadata). A
# # granted key whose benefit is missing from this map is DENIED — keep it in
# # sync with the License Key benefits on your Polar products.
# [polar.benefits]
# "YOUR-INDIE-LICENSE-BENEFIT-UUID" = 3
# "YOUR-PRO-LICENSE-BENEFIT-UUID" = 10
# "YOUR-TEAM-LICENSE-BENEFIT-UUID" = 30
